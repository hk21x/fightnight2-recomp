# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe
GAME_LOG=fightnight2     # GameInfo::log
GAME_TARGET=FightNight2  # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=fightnight2
SMOKE_PAD=scripts/pad/fight.txt  # title, autosave Yes, Play Now, Hopkins v Wright at the Staples Center; round 1 from about vblank 3200
SMOKE_MENU="2500 2680"    # Select Venue (about 67 draws a frame), just before the last menu choice
SMOKE_SECS=150            # the fight from about 55 s
SOAK_PAD=                # a program printing a pad script for N seconds of races back to back
